// prisma/schema.prisma
// Prisma 7: generator="prisma-client", no url in datasource, import from @/generated/prisma/client
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ── Core users ─────────────────────────────────────────────────────────────────

model User {
  id                String    @id @default(uuid())
  email             String    @unique
  name              String?
  emailVerified     DateTime?
  image             String?
  native_lang       String    @default("en")
  analysis_provider String    @default("haiku")  // "haiku" | "sonnet" | "free"
  created_at        DateTime  @default(now())

  accounts         Account[]
  sessions         Session[]
  languageProfiles UserLanguageProfile[]
  srsCards         SrsCard[]
  reviewLogs       ReviewLog[]
}

// NextAuth.js v5 adapter tables
model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ── Per-user language state ────────────────────────────────────────────────────

model UserLanguageProfile {
  id                 String   @id @default(uuid())
  user_id            String
  language_code      String
  vocabulary_level   String   @default("A1")
  script_familiarity Int      @default(0)
  updated_at         DateTime @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, language_code])
  @@map("user_language_profiles")
}

// ── Song catalog ───────────────────────────────────────────────────────────────

model Song {
  id            String   @id @default(uuid())
  title         String
  artist        String
  language_code String
  duration_ms   Int
  media_type    String   // 'html5' | 'youtube' | 'spotify'
  media_id      String
  lrclib_id     Int?
  created_at    DateTime @default(now())

  lyrics     Lyrics?
  difficulty SongDifficulty?
  srsCards   SrsCard[]
}

model Lyrics {
  id         String   @id @default(uuid())
  song_id    String   @unique
  // words: LyricWord[] — { text, romanization, start_ms, end_ms, cefr_level }
  // lines: LyricLine[] — { lineIndex, start_ms, end_ms, wordStart, wordEnd }
  words      Json
  lines      Json
  created_at DateTime @default(now())

  song Song @relation(fields: [song_id], references: [id], onDelete: Cascade)
}

model SongDifficulty {
  song_id          String   @id
  vocab_cefr       String   // A1–C2
  audio_speed_wpm  Float
  grammar_score    Float    // 1–10
  composite_level  String   // A1–C2
  computed_at      DateTime @default(now())

  song Song @relation(fields: [song_id], references: [id], onDelete: Cascade)
}

// ── SRS (Spaced Repetition) ───────────────────────────────────────────────────

model SrsCard {
  id             String   @id @default(uuid())
  user_id        String
  language_code  String
  word           String
  romanization   String?
  meaning        String?
  context_song   String?
  fsrs_state     Json     @default("{}")
  next_review_at DateTime @default(now())
  created_at     DateTime @default(now())

  user       User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  song       Song?     @relation(fields: [context_song], references: [id])
  reviewLogs ReviewLog[]

  // IMPORTANT: 'word' must be lowercased at the application layer before insert/upsert
  // to avoid duplicates ('Dis-moi' vs 'dis-moi'). PostgreSQL collation is case-sensitive.
  @@unique([user_id, language_code, word])
  @@index([user_id, next_review_at])  // review queue: WHERE user_id = ? AND next_review_at <= now()
  @@map("srs_cards")
}

model ReviewLog {
  id          BigInt   @id @default(autoincrement())
  card_id     String
  user_id     String
  rating      Int
  reviewed_at DateTime @default(now())

  card SrsCard @relation(fields: [card_id], references: [id], onDelete: Cascade)
  user User    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("review_logs")
}

// Claude/free analysis cache — 90-day TTL, keyed per provider
// context defaults to '' (not NULL) to satisfy @@unique (NULL != NULL in PostgreSQL)
// provider field isolates pro and free results — switching modes re-analyzes
model VocabCache {
  id            String   @id @default(uuid())
  language_code String
  word          String
  context       String   @default("")
  provider      String   @default("haiku")
  is_partial    Boolean  @default(false)
  analysis      Json
  created_at    DateTime @default(now())
  expires_at    DateTime @default(dbgenerated("now() + interval '90 days'"))

  @@unique([language_code, word, context, provider])
  @@map("vocab_cache")
  @@index([expires_at])   // required for efficient TTL purge jobs
}
