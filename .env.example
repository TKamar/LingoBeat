# LingoBeat Environment Configuration
# Copy this file to .env and fill in the values for your environment.
# Never commit .env to git.

# ── Database ───────────────────────────────────────────────────────────────────
# DEV  (Docker Compose, port 5433 avoids conflict with any local Postgres on 5432)
DATABASE_URL="postgresql://lingobeat:lingobeat@127.0.0.1:5433/lingobeat"
# PROD (Neon serverless — Settings → Connection string → "Pooled connection")
# DATABASE_URL="postgresql://username:password@ep-xxx.neon.tech/lingobeat?sslmode=require"

# ── Auth (NextAuth.js v5) ──────────────────────────────────────────────────────
# Generate: openssl rand -base64 32
AUTH_SECRET="replace-with-random-secret"

# DEV
NEXTAUTH_URL="http://localhost:3000"
# PROD (set to your deployed domain)
# NEXTAUTH_URL="https://lingobeat.com"

# Google OAuth — required for production login
# Create credentials at https://console.cloud.google.com → APIs & Services → Credentials
# For dev, the /api/dev/login-as endpoint bypasses OAuth entirely (unavailable in prod)
GOOGLE_CLIENT_ID="from Google Cloud Console OAuth 2.0"
GOOGLE_CLIENT_SECRET="from Google Cloud Console OAuth 2.0"

# ── Python microservice (vocab analysis) ─────────────────────────────────────
# DEV  (Docker Compose service, see docker-compose.yml)
PYTHON_SERVICE_URL="http://localhost:8000"
# PROD (deployed service URL, e.g. Railway, Fly.io, or Cloud Run)
# PYTHON_SERVICE_URL="https://your-python-service.fly.dev"

# Anthropic API key — required only when ANALYSIS_PROVIDER != "free"
ANTHROPIC_API_KEY="sk-ant-..."

# Default analysis provider: "free" | "haiku" | "sonnet"
# DEV: set to "free" to avoid API costs during testing
ANALYSIS_PROVIDER="haiku"

# ── Development-only flags ────────────────────────────────────────────────────
# NODE_ENV is set automatically by Next.js (development / production / test)
# Do NOT set NODE_ENV manually here.
#
# The /api/dev/login-as endpoint is disabled automatically when NODE_ENV=production.
# It creates real DB sessions for demo users without Google OAuth — dev only.
