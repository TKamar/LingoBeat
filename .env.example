# ── Local development (Docker Compose) ────────────────────────────────────────
# 1. Run `npm run db:up` to start the container
# 2. Use port 5433 — avoids conflict if you have a local Postgres on 5432
DATABASE_URL="postgresql://lingobeat:lingobeat@127.0.0.1:5433/lingobeat"

# ── Production (Neon) ─────────────────────────────────────────────────────────
# Replace with your Neon connection string (Settings → Connection string):
# DATABASE_URL="postgresql://username:password@host/lingobeat?sslmode=require"

# Auth (NextAuth.js v5)
AUTH_SECRET="generate-with: openssl rand -base64 32"
# NEXTAUTH_SECRET works as a fallback for compatibility with older versions
NEXTAUTH_URL="http://localhost:3000"
GOOGLE_CLIENT_ID="from Google Cloud Console OAuth 2.0"
GOOGLE_CLIENT_SECRET="from Google Cloud Console OAuth 2.0"
